# ---- server ----
PORT=8080
# Public URL of the Next.js site (used in email links)
SITE_URL=http://localhost:3000
# Set to true in production (HTTPS) so the auth cookie is Secure
COOKIE_SECURE=false

# ---- database ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dado

# ---- auth ----
# Signs the admin JWT (24h). Changing it signs everyone out.
JWT_SECRET=change-me-to-64-random-hex-chars
# First admin, created on first start when no admin exists yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# ---- email (Gmail API over HTTPS; see README → Email setup) ----
# The Gmail account that sends the mail, and its OAuth client + refresh token.
# Leave the three GMAIL_CLIENT_*/REFRESH values empty to run without email.
GMAIL_SENDER=you@gmail.com
GMAIL_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your-client-secret
GMAIL_REFRESH_TOKEN=1//your-refresh-token
MAIL_FROM_NAME=DADO Post-Production
# Where new contact / trial alerts go
NOTIFY_EMAIL=you@example.com

# ---- image uploads (Cloudinary) — leave empty until you have the keys ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
