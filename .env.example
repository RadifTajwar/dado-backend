# ---- server ----
PORT=8080
# Public URL of the Next.js site (used in email links)
SITE_URL=http://localhost:3000
# Set to true in production (HTTPS) so the auth cookie is Secure
COOKIE_SECURE=false

# ---- database ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dado

# ---- auth ----
# Signs the admin JWT (24h). Changing it signs everyone out.
JWT_SECRET=change-me-to-64-random-hex-chars
# First admin, created on first start when no admin exists yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# ---- email (Gmail SMTP with an app password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
MAIL_FROM_NAME=DADO Post-Production
# Where new contact / trial alerts go
NOTIFY_EMAIL=you@example.com

# ---- image uploads (Cloudinary) — leave empty until you have the keys ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
